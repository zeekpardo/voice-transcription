# --- xAI (server-side only; never exposed to callers) ---
XAI_API_KEY="xai-..."
XAI_BASE_URL="https://api.x.ai/v1"

# --- server ---
PORT="8787"

# --- storage (SQLite file for issued keys + usage) ---
DB_PATH="./data/gateway.db"

# --- transcription defaults ---
DEFAULT_LANGUAGE="en"
STT_FORMAT="true"            # xAI STT "format" field: true = formatted/natural text
MAX_UPLOAD_BYTES="157286400" # 150 MB cap for audio uploads (~90 min)

# --- media (video files + URLs; needs ffmpeg + yt-dlp) ---
MEDIA_MAX_UPLOAD_BYTES="1073741824"  # 1 GB cap for uploaded video files
MEDIA_MAX_DURATION_SECONDS="5400"    # extract/transcribe up to 1 h 30 min
